{
  "name": "@fhirjs/server",
  "description": "FHIR REST server: a fetch-style handler over stores of your own",
  "keywords": [
    "fhir",
    "hl7",
    "hl7-fhir",
    "healthcare",
    "health",
    "medical",
    "interoperability",
    "typescript",
    "fhir-server",
    "rest",
    "rest-api",
    "api-server",
    "smart-on-fhir",
    "authorization",
    "bulk-data",
    "facade",
    "fetch"
  ],
  "version": "1.0.0-beta.1",
  "private": true,
  "license": "BSD-3-Clause",
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fhirjs/core": "workspace:^",
    "@fhirjs/fhirpath": "workspace:^",
    "@fhirjs/smart": "workspace:^",
    "tslib": "^2.9.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/panates/fhirjs.git",
    "directory": "packages/server"
  },
  "publishConfig": {
    "access": "public",
    "directory": "build",
    "linkDirectory": true
  },
  "devDependencies": {
    "expect": "^30.5.2"
  }
}
