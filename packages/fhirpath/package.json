  "keywords": [
    "fhir",
    "hl7",
    "hl7-fhir",
    "healthcare",
    "health",
    "medical",
    "interoperability",
    "typescript",
    "fhirpath",
    "fhirpath-engine",
    "expression",
    "parser",
    "evaluator",
    "query"
  ],
  "version": "1.0.0-beta.1",
  "private": true,
  "license": "BSD-3-Clause",
  "type": "module",
  "exports": {
