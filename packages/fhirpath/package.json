    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "tslib": "^2.9.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/panates/fhirjs.git",
