{
  "name": "@fhirjs/client",
  "description": "FHIR REST client: typed resources through @fhirjs/core",
  "version": "0.0.0",
  "private": true,
  "license": "BSD-3-Clause",
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fhirjs/core": "workspace:^",
    "@fhirjs/smart": "workspace:^",
