{
  "name": "@fhirjs/client",
  "description": "FHIR REST client: typed resources through @fhirjs/core",
  "keywords": [
    "fhir",
    "hl7",
    "hl7-fhir",
    "healthcare",
    "health",
    "medical",
    "interoperability",
    "typescript",
    "fhir-client",
    "rest",
    "rest-client",
    "api-client",
    "smart-on-fhir",
    "smart",
    "oauth2",
    "bulk-data",
    "pkce"
  ],
  "version": "0.0.0",
  "private": true,
  "license": "BSD-3-Clause",
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fhirjs/core": "workspace:^",
    "@fhirjs/smart": "workspace:^",
    "tslib": "^2.9.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/panates/fhirjs.git",
    "directory": "packages/client"
  },
  "publishConfig": {
    "access": "public",
    "directory": "build",
    "linkDirectory": true
  },
  "devDependencies": {
    "expect": "^30.5.2"
  }
