{
  "name": "fhir",
  "private": true,
  "version": "0.0.0",
  "license": "BSD-3-Clause",
  "type": "module",
  "engines": {
    "node": ">=22.0"
  },
  "packageManager": "pnpm@12.10.1",
  "scripts": {
    "fetch-packages": "node support/fetch-packages.mts",
    "generate": "node support/build-models.mts --version=R4 && node support/build-models.mts --version=R4B && node support/build-models.mts --version=R5",
    "build": "tsc -b packages/smart/tsconfig-build.json packages/fhirpath/tsconfig-build.json packages/core/tsconfig-build.json packages/r4/tsconfig-build.json packages/r4b/tsconfig-build.json packages/r5/tsconfig-build.json packages/client/tsconfig-build.json packages/server/tsconfig-build.json",
    "check-types": "tsc -b",
    "examples": "tsc -p examples && node examples/build/profile/run.js",
    "test": "mocha",
    "citest": "c8 mocha",
    "bench": "node support/bench-codec.mts"
  },
  "devDependencies": {
    "@fhirjs/client": "workspace:*",
    "@fhirjs/core": "workspace:*",
    "@fhirjs/fhirpath": "workspace:*",
    "@fhirjs/r4": "workspace:*",
    "@fhirjs/r4b": "workspace:*",
    "@fhirjs/r5": "workspace:*",
    "@fhirjs/server": "workspace:*",
    "@fhirjs/smart": "workspace:*",
    "@panates/tsconfig": "^2.1.8",
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.16.22",
    "@swc/helpers": "^0.5.24",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.6",
    "c8": "^12.0.0",
    "expect": "^30.5.2",
    "fhirpath": "5.2.3",
    "mocha": "^12.0.3",
    "prettier": "^3.10.1",
    "tslib": "^2.9.1",
    "typescript": "^6.0.3",
    "valgen": "^7.0.13"
  }
}
